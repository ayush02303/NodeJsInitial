<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Congrats ! You've written <%= rand  %></h1>
    <% if( rand%2 == 0 ) {%>
    <h2>This is an even number</h2>
    <% }else{  %>
    <h3>Sorry Buddy! Odd number this time</h3>
    <% } %>
    <h3><%= rand %2 == 0 ? "Even" : "Odd" %></h3>
    
</body>
</html>